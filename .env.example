# Copy to `.env.local` (git-ignored) and fill in values. This file lists names only.
# Set backend and hosting URLs in your local `.env.local` — never commit them.

############################
# Convex – Client (Frontend)
############################

# Browser / Vite: Convex client URL (not the HTTP/actions site URL)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

############################
# Convex – Deployment (self-hosted)
############################

# Used by `bun run deploy:convex`. Do not set CONVEX_DEPLOYMENT for self-hosted Pindeck.
CONVEX_SELF_HOSTED_URL=
PINDECK_CONVEX_SELF_HOSTED_ADMIN_KEY=
CONVEX_SELF_HOSTED_ADMIN_KEY=

############################
# Backend / AI Providers (Convex dashboard / server env)
############################

OPEN_ROUTER_KEY=
GOOGLE_API_KEY=
FAL_KEY=
JWT_PRIVATE_KEY=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public app URL for OAuth redirects (no trailing slash). Production: https://pindeck.dev
SITE_URL=

############################
# Discord Bot / Ingest (external discord-bot repo)
############################

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_IMAGES_JSON=
DISCORD_INGEST_EMOJIS=
PINDECK_INGEST_URL=
PINDECK_DISCORD_QUEUE_URL=
PINDECK_DISCORD_MODERATION_URL=
ADMIN_USER_IDS=
ADMIN_EMAILS=
INGEST_API_KEY=

############################
# Media (RustFS gateway)
############################

MEDIA_GATEWAY_URL=
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_BUCKET=pindeck
MEDIA_GATEWAY_USER_ID=pindeck
MEDIA_GATEWAY_UPLOAD_PREFIX=media-uploads
PINDECK_STORAGE_PROVIDER=rustfs

############################
# Trigger.dev orchestration
############################

PINDECK_TRIGGER_ORCHESTRATION_ENABLED=false
TRIGGER_PROJECT_REF=
TRIGGER_API_URL=
TRIGGER_SECRET_KEY=
PINDECK_CONVEX_SITE_URL=
PINDECK_ORCHESTRATION_TOKEN=

DISCORD_STATUS_WEBHOOK_URL=

############################
# E2E (local only — never commit values)
############################

E2E_EMAIL=
E2E_PASSWORD=

############################
# Upload UI – Pinterest ingest sidecar base URL
############################

VITE_PINTEREST_INGEST_BASE_URL=

DISCORD_INGEST_DEFAULT_TAGS=discord,imported
DISCORD_INGEST_DEFAULT_CATEGORY=General
DISCORD_INGEST_CONFIRMATIONS=1
DISCORD_INGEST_FETCH_EXTERNAL=1
DISCORD_INGEST_MAX_IMAGES_PER_POST=1
DISCORD_GENERATE_DEFAULT_COUNT=2
DISCORD_GENERATE_DEFAULT_MODE=shot-variation
DISCORD_APPROVED_VARIATION_BUTTONS=1
